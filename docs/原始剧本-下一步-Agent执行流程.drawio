        <mxCell id="e15" value="仅 MultiEdit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8C69B4;" edge="1" parent="1" source="c4" target="r5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="第二次 finalize 失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D86A61;" edge="1" parent="1" source="r5" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
