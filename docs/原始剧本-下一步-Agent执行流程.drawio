<mxfile host="app.diagrams.net" modified="2026-07-16T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="original-script-next" name="原始剧本到故事梗概">
    <mxGraphModel dx="1800" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="原始剧本点击“下一步”后的 Agent 执行路径" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1D3557;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="范围：项目初始化完成，当前停留在“原始剧本”；目标：生成待用户确认的《故事梗概》" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#5B6472;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1000" height="28" as="geometry"/></mxCell>

        <mxCell id="lane-ui" value="用户与前端" style="swimlane;html=1;rounded=0;startSize=32;fontStyle=1;fontSize=16;fontColor=#1D3557;fillColor=#EAF4FF;swimlaneFillColor=#F8FBFF;strokeColor=#8AB6D6;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="460" height="1010" as="geometry"/></mxCell>
        <mxCell id="lane-api" value="API 与任务编排" style="swimlane;html=1;rounded=0;startSize=32;fontStyle=1;fontSize=16;fontColor=#6A3D00;fillColor=#FFF3DB;swimlaneFillColor=#FFFDF8;strokeColor=#E6B45E;" vertex="1" parent="1"><mxGeometry x="510" y="110" width="510" height="1010" as="geometry"/></mxCell>
        <mxCell id="lane-skill" value="outline_rewrite Skill 与运行态" style="swimlane;html=1;rounded=0;startSize=32;fontStyle=1;fontSize=16;fontColor=#1C5B3C;fillColor=#E7F7EC;swimlaneFillColor=#FAFFFC;strokeColor=#7DBB91;" vertex="1" parent="1"><mxGeometry x="1040" y="110" width="620" height="1010" as="geometry"/></mxCell>
        <mxCell id="lane-model" value="Claude Code 创作 Agent" style="swimlane;html=1;rounded=0;startSize=32;fontStyle=1;fontSize=16;fontColor=#5A348A;fillColor=#F2EAFE;swimlaneFillColor=#FCFAFF;strokeColor=#B292D1;" vertex="1" parent="1"><mxGeometry x="1680" y="110" width="480" height="1010" as="geometry"/></mxCell>

        <mxCell id="u1" value="用户在“原始剧本”&lt;br&gt;点击【下一步】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D7EBFF;strokeColor=#4F91C5;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="105" y="175" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="u2" value="前端前置判断&lt;br&gt;• 当前文档是否已保存&lt;br&gt;• 原始剧本是否可批准&lt;br&gt;• 是否已有进行中的任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#8AB6D6;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="85" y="290" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="u3" value="若当前阶段为 draft_ready：&lt;br&gt;POST /stages/project_init/approve&lt;br&gt;状态：draft_ready → approved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E8;strokeColor=#D79B3D;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="85" y="435" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="u4" value="生成并提交 job 请求&lt;br&gt;&lt;br&gt;stage = outline_rewrite&lt;br&gt;target_stage = outline_rewrite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D7EBFF;strokeColor=#4F91C5;fontSize=14;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="85" y="575" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="u5" value="写入 job.prompt 的用户提示词&lt;br&gt;&lt;br&gt;用户请求：&lt;br&gt;当前阶段“原始剧本”已完成人工审核，请执行下一阶段“故事梗概”并生成对应阶段内容。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#D7A74A;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="725" width="370" height="130" as="geometry"/></mxCell>
        <mxCell id="u6" value="页面先显示“故事梗概生成中”&lt;br&gt;通过 job/events 获取进度；完成后加载 02-故事梗概.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#8AB6D6;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="85" y="930" width="340" height="85" as="geometry"/></mxCell>

        <mxCell id="a1" value="POST /projects/{id}/agent/jobs&lt;br&gt;创建 agent_jobs 记录&lt;br&gt;status = queued" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6B8;strokeColor=#D79B3D;fontSize=14;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="590" y="175" width="350" height="80" as="geometry"/></mxCell>
        <mxCell id="a2" value="固定阶段映射&lt;br&gt;project_init → outline_rewrite&lt;br&gt;不是由模型自由决定下一阶段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#E6B45E;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="590" y="300" width="350" height="78" as="geometry"/></mxCell>
        <mxCell id="a3" value="run_agent_job 后台任务&lt;br&gt;• job：queued → running&lt;br&gt;• 同步 Memory&lt;br&gt;• 固化本次用户偏好快照&lt;br&gt;• 创建运行日志 / 事件流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#D79B3D;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="570" y="425" width="390" height="110" as="geometry"/></mxCell>
        <mxCell id="a4" value="调用 init-outline.mjs&lt;br&gt;这是后端对 Skill 的受管调用；&lt;br&gt;不是 Claude 自主选择 /outline_rewrite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6B8;strokeColor=#D79B3D;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="590" y="585" width="350" height="84" as="geometry"/></mxCell>
        <mxCell id="a5" value="执行 Claude Code -p&lt;br&gt;并记录原始流式日志、工具调用、结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#E6B45E;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="590" y="730" width="350" height="75" as="geometry"/></mxCell>
        <mxCell id="a6" value="事务性交付保护&lt;br&gt;失败、越权写入或质检失败：&lt;br&gt;恢复之前的用户可见文件与进度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#D86A61;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="570" y="875" width="390" height="90" as="geometry"/></mxCell>
        <mxCell id="a7" value="成功：job → succeeded&lt;br&gt;故事梗概保持 draft_ready，等待用户下一次点击“下一步”确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F7EC;strokeColor=#62A879;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="570" y="1015" width="390" height="70" as="geometry"/></mxCell>

        <mxCell id="s1" value="init-outline.mjs：输入校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#62A879;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="175" width="340" height="55" as="geometry"/></mxCell>
        <mxCell id="s2" value="读取的持久文件&lt;br&gt;• 01-国内原始剧本.md&lt;br&gt;• 01-user-input.json&lt;br&gt;• 01-project-progress.json&lt;br&gt;• Memory / 地区规则 / 偏好快照&lt;br&gt;&lt;br&gt;校验：上游已批准、Memory 新鲜、发行 locale 完整" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFFFC;strokeColor=#7DBB91;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1110" y="270" width="460" height="155" as="geometry"/></mxCell>
        <mxCell id="s3" value="构建 job 私有上下文&lt;br&gt;runtime/jobs/{job_id}/&lt;br&gt;• outline-brief.json&lt;br&gt;• stage-context.json&lt;br&gt;• context/story-index.json 等" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#62A879;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1110" y="475" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="s4" value="信息扭转：Outline Brief&lt;br&gt;&lt;br&gt;原始正文 → 带行号 source_index（可按需回读）&lt;br&gt;用户需求 + 地区规则 + 偏好 → 改编约束&lt;br&gt;输出协议 → 私有 Canon 的字段与公开交付边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#D7A74A;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1090" y="625" width="500" height="125" as="geometry"/></mxCell>
        <mxCell id="s5" value="初始化写入运行态&lt;br&gt;outline_rewrite：queued / in_progress&lt;br&gt;并返回给后端：Brief 路径、私有草稿路径、Context 路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFFFC;strokeColor=#7DBB91;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1110" y="805" width="460" height="78" as="geometry"/></mxCell>
        <mxCell id="s6" value="validate-outline.mjs&lt;br&gt;校验私有 Canon：连续性、逐集卡、人物状态、钩子、反模板、公开边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#62A879;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1110" y="935" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="s7" value="通过才物化（发布）&lt;br&gt;私有 Canon → 02-故事梗概.md&lt;br&gt;并更新 01-project-progress.json：draft_ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#398C58;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1110" y="1050" width="460" height="55" as="geometry"/></mxCell>

        <mxCell id="m1" value="后端拼装给 Claude 的系统执行提示&lt;br&gt;&lt;br&gt;阶段：故事梗概&lt;br&gt;Outline Brief 路径&lt;br&gt;隐藏 Canon 草稿路径&lt;br&gt;+ 前端传入的用户提示词" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9DDF9;strokeColor=#8C69B4;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1740" y="175" width="360" height="125" as="geometry"/></mxCell>
        <mxCell id="m2" value="Claude 的读取规则&lt;br&gt;1. 先读 outline-brief.json&lt;br&gt;2. 按 source_index 回读原始剧本的必要段落&lt;br&gt;3. 不读公开梗概、人物小传、参考库&lt;br&gt;4. 不能把摘要当作原剧事实" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFAFF;strokeColor=#B292D1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1740" y="365" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="m3" value="Claude 的唯一写入目标&lt;br&gt;runtime/jobs/{job_id}/…/outline_draft&lt;br&gt;&lt;br&gt;内容：私有故事 Canon&lt;br&gt;不得直接修改公开 02-故事梗概.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9DDF9;strokeColor=#8C69B4;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1740" y="555" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="m4" value="私有 Canon 的含义&lt;br&gt;保留原剧的因果、关系动作、信息差、选择代价和情绪回报；重构目标地区的制度、职业、场景和表达。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#D7A74A;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1740" y="725" width="360" height="105" as="geometry"/></mxCell>
        <mxCell id="m5" value="重要：Claude 结束写作后，不负责发布。后端校验才决定该候选是否能成为用户看到的梗概。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#D86A61;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1740" y="900" width="360" height="90" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4F91C5;" edge="1" parent="1" source="u1" target="u2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="需要确认" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D79B3D;" edge="1" parent="1" source="u2" target="u3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4F91C5;" edge="1" parent="1" source="u2" target="u4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4F91C5;" edge="1" parent="1" source="u3" target="u4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4F91C5;" edge="1" parent="1" source="u4" target="u5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="HTTP 请求" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4F91C5;" edge="1" parent="1" source="u4" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D79B3D;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D79B3D;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D79B3D;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Node 脚本" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#62A879;" edge="1" parent="1" source="a4" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#62A879;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#62A879;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#62A879;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#62A879;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="初始化返回路径" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D79B3D;" edge="1" parent="1" source="s5" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="最终提示词" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8C69B4;" edge="1" parent="1" source="a5" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8C69B4;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8C69B4;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell>
