  <diagram id="job-81-outline-actual" name="Job 81 实际执行复盘">
    <mxGraphModel dx="1800" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="Job 81《His Little Bomb》故事梗概：实际执行与文件变更复盘" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1D3557;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="sub" value="数据源：agent_job_81.jsonl、SQLite job/events、runtime/jobs/81 文件与交付快照。执行结论：Job 失败，用户可见梗概未发布。图中保留当时的 prepare/finalize 脚本名；当前版本对应 init/validate。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#5B6472;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="28" as="geometry"/></mxCell>

        <mxCell id="l1" value="持久工作区（用户可见 / 受保护）" style="swimlane;html=1;rounded=0;startSize=32;fontStyle=1;fontSize=16;fontColor=#1D3557;fillColor=#EAF4FF;swimlaneFillColor=#F8FBFF;strokeColor=#8AB6D6;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="500" height="1030" as="geometry"/></mxCell>
        <mxCell id="l2" value="后端编排与质量门" style="swimlane;html=1;rounded=0;startSize=32;fontStyle=1;fontSize=16;fontColor=#6A3D00;fillColor=#FFF3DB;swimlaneFillColor=#FFFDF8;strokeColor=#E6B45E;" vertex="1" parent="1"><mxGeometry x="550" y="110" width="530" height="1030" as="geometry"/></mxCell>
        <mxCell id="l3" value="Job 81 私有运行态（失败后仍保留）" style="swimlane;html=1;rounded=0;startSize=32;fontStyle=1;fontSize=16;fontColor=#1C5B3C;fillColor=#E7F7EC;swimlaneFillColor=#FAFFFC;strokeColor=#7DBB91;" vertex="1" parent="1"><mxGeometry x="1100" y="110" width="570" height="1030" as="geometry"/></mxCell>
        <mxCell id="l4" value="Claude Code（两轮）" style="swimlane;html=1;rounded=0;startSize=32;fontStyle=1;fontSize=16;fontColor=#5A348A;fillColor=#F2EAFE;swimlaneFillColor=#FCFAFF;strokeColor=#B292D1;" vertex="1" parent="1"><mxGeometry x="1690" y="110" width="470" height="1030" as="geometry"/></mxCell>

        <mxCell id="p1" value="01-国内原始剧本.md&lt;br&gt;事实源，共约 2,100 行&lt;br&gt;本次被完整读取：1–2100 行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D7EBFF;strokeColor=#4F91C5;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="100" y="175" width="350" height="85" as="geometry"/></mxCell>
        <mxCell id="p2" value="01-user-input.json&lt;br&gt;北美 / en-US / TikTok / 60 集&lt;br&gt;补充要求：不再做文化映射，精细优化内容" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D7EBFF;strokeColor=#4F91C5;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="100" y="305" width="350" height="90" as="geometry"/></mxCell>
        <mxCell id="p3" value="01-project-progress.json&lt;br&gt;初始：outline_rewrite = queued&lt;br&gt;prepare 曾改为 in_progress&lt;br&gt;失败回滚后恢复为 queued" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#D7A74A;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="100" y="450" width="350" height="100" as="geometry"/></mxCell>
        <mxCell id="p4" value="02-故事梗概.md&lt;br&gt;执行前不存在；本次未发布，执行后仍不存在" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#D86A61;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="100" y="625" width="350" height="75" as="geometry"/></mxCell>
        <mxCell id="p5" value="memory/outline-canon.json&lt;br&gt;执行前不存在；本次未写入，执行后仍不存在" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#D86A61;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="100" y="745" width="350" height="75" as="geometry"/></mxCell>
        <mxCell id="p6" value="delivery-snapshot/&lt;br&gt;开始前备份 01-project-progress、原剧、用户输入、Memory 及拟发布文件。&lt;br&gt;失败时用它恢复持久文件。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#D79B3D;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="85" y="860" width="380" height="105" as="geometry"/></mxCell>
        <mxCell id="p7" value="最终可见状态（实际）&lt;br&gt;DB：agent_jobs #81 = failed / QUALITY_GATE&lt;br&gt;工作区进度：仍为 queued&lt;br&gt;公开梗概：不存在" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C7463A;fontSize=14;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="85" y="1010" width="380" height="90" as="geometry"/></mxCell>

        <mxCell id="b1" value="01:49:54 创建 Job 81&lt;br&gt;DB agent_jobs：queued&lt;br&gt;并标记项目阶段 queued" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6B8;strokeColor=#D79B3D;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="635" y="175" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="b2" value="01:49:55 任务开始&lt;br&gt;DB job：queued → running&lt;br&gt;创建交付快照，禁止未通过内容进入用户文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#D79B3D;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="615" y="305" width="400" height="85" as="geometry"/></mxCell>
        <mxCell id="b3" value="prepare-outline.mjs 条件&lt;br&gt;1. 必要输入文件存在&lt;br&gt;2. project_init=completed&lt;br&gt;3. Memory 新鲜&lt;br&gt;4. 发行 locale 合法且单一&lt;br&gt;&lt;br&gt;满足后：进度写为 in_progress，并生成私有上下文。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#E6B45E;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="600" y="455" width="430" height="145" as="geometry"/></mxCell>
        <mxCell id="b4" value="第一次 finalize：把私有草稿解析为 Canon 并校验&lt;br&gt;条件：完整梗概 + 第1–60集连续卡 + 单元覆盖每集 + 卡字段/反模板通过。&lt;br&gt;失败：生成 repair-brief，允许一次定向修复。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#D7A74A;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="600" y="680" width="430" height="125" as="geometry"/></mxCell>
        <mxCell id="b5" value="第二次 finalize 仍未通过&lt;br&gt;原因：仅有第1–35集卡；第36–60集只有“剧情单元描述”，没有逐集卡。&lt;br&gt;→ QUALITY_GATE → 回滚交付快照。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#D86A61;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="600" y="875" width="430" height="110" as="geometry"/></mxCell>
        <mxCell id="b6" value="失败后留下运行证据&lt;br&gt;runtime/jobs/81/delivery-rejected.json&lt;br&gt;原因：OUTLINE_SYNOPSIS_MISSING、OUTLINE_EPISODE_SEQUENCE_INVALID、OUTLINE_NARRATIVE_UNIT_INVALID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#D86A61;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="600" y="1035" width="430" height="70" as="geometry"/></mxCell>

        <mxCell id="r1" value="prepare 写入的运行文件&lt;br&gt;runtime/jobs/81/&lt;br&gt;• outline-brief.json&lt;br&gt;• stage-context.json&lt;br&gt;• context/story-index.json 等&lt;br&gt;• user-preferences.json（本次有效偏好为 0）&lt;br&gt;• outline-public-guard.json（记录公开梗概原本不存在）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#62A879;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1160" y="175" width="450" height="150" as="geometry"/></mxCell>
        <mxCell id="r2" value="outline-brief.json 的信息扭转&lt;br&gt;• 原剧 → 60 集 source_index（带行号）&lt;br&gt;• 发行任务书 / 地区规则 / 用户要求 → 改编约束&lt;br&gt;• 输出协议 → Canon 必填字段与公开文件边界&lt;br&gt;• 明确禁止读公开梗概、人物小传、参考库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#D7A74A;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1160" y="375" width="450" height="130" as="geometry"/></mxCell>
        <mxCell id="r3" value="Claude 唯一被允许写入的文件&lt;br&gt;runtime/jobs/81/outline-canon-draft.md&lt;br&gt;&lt;br&gt;首次 Write：18,846 字符&lt;br&gt;最终结构：完整梗概 + 7 个剧情单元 + 35 个逐集 Canon 卡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#398C58;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1160" y="565" width="450" height="105" as="geometry"/></mxCell>
        <mxCell id="r4" value="一次修复的输入与写入边界&lt;br&gt;读取 repair-brief.json 与 Canon 草稿；只允许编辑 Canon 草稿。&lt;br&gt;禁止：02-故事梗概.md、03-人物小传.md。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFFFC;strokeColor=#7DBB91;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1160" y="730" width="450" height="85" as="geometry"/></mxCell>
        <mxCell id="r5" value="实际 MultiEdit（2 处）&lt;br&gt;1. “整体说明” → “完整梗概”&lt;br&gt;2. 剧情单元从 4 段扩展为 7 段（补到第60集）&lt;br&gt;&lt;br&gt;未新增第36–60集的 25 张 Canon 卡。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#D86A61;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1160" y="875" width="450" height="105" as="geometry"/></mxCell>
        <mxCell id="r6" value="失败后保留：outline-canon-draft.md、repair-brief.json、delivery-rejected.json、日志、快照。&lt;br&gt;不保留为用户交付：02-故事梗概.md / memory/outline-canon.json。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#9AA8B5;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1160" y="1030" width="450" height="75" as="geometry"/></mxCell>

        <mxCell id="c1" value="第 1 轮 Claude&lt;br&gt;session: 7b067591…&lt;br&gt;01:49:59–01:56:16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9DDF9;strokeColor=#8C69B4;fontSize=14;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1750" y="175" width="350" height="75" as="geometry"/></mxCell>
        <mxCell id="c2" value="读取行为&lt;br&gt;1. Read outline-brief.json&lt;br&gt;2. 分 4 次 Read 原剧：1–674、675–1326、1327–2000、2001–2100&lt;br&gt;3. Write 私有 Canon 草稿&lt;br&gt;4. Read 草稿前 60 行自检" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFAFF;strokeColor=#B292D1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1750" y="310" width="350" height="125" as="geometry"/></mxCell>
        <mxCell id="c3" value="第 1 轮结果&lt;br&gt;声称完成隐藏 Canon；实际只生成 1–35 集逐集卡。&lt;br&gt;质量门拒绝，不触达公开文件。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#D86A61;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1750" y="500" width="350" height="90" as="geometry"/></mxCell>
        <mxCell id="c4" value="第 2 轮 Claude（修复会话）&lt;br&gt;01:56:16–01:57:52&lt;br&gt;读取 repair brief、检查标题/集数，再 MultiEdit 草稿。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9DDF9;strokeColor=#8C69B4;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1750" y="675" width="350" height="85" as="geometry"/></mxCell>
        <mxCell id="c5" value="修复偏差&lt;br&gt;修复意图是“补齐至 60 集”，实际只补了第36–60集的剧情单元摘要，未生成 25 集的逐集卡。&lt;br&gt;因此仍不满足 finalizer 的连续卡要求。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C7463A;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1750" y="835" width="350" height="115" as="geometry"/></mxCell>

