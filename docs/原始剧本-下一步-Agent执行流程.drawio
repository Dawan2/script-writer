        <mxCell id="e7" value="prepare 输出" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#62A879;" edge="1" parent="1" source="b3" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#62A879;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="提示词 + Brief" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8C69B4;" edge="1" parent="1" source="r2" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8C69B4;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="Write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8C69B4;" edge="1" parent="1" source="c2" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="首次 finalize" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D79B3D;" edge="1" parent="1" source="r3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="质量失败 → repair brief" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D86A61;" edge="1" parent="1" source="b4" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell>
