        <mxCell id="e4" value="读取" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#62A879;" edge="1" parent="1" source="p1" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#62A879;" edge="1" parent="1" source="p2" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell>
