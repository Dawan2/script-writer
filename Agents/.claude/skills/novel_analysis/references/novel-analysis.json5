{
  "基础信息": {
    "小说名称": "",
    "小说梗概": "",
    // 使用数组逐项记录题材，例如 ["都市情感", "身份悬疑"]。
    "题材": [],
    "基调": ""
  },
  // 说明观众为何持续追看，以及该承诺如何被故事不断兑现。
  "核心卖点": "",
  // 主角的行动、阻碍、升级、代价和结局形成的主因果链。
  "故事主线": "",
  // 会限制人物行动、制造冲突或改变结果的环境与规则。
  "世界观": "",
  // 仅全书主要角色；局部角色只写入其所在剧情单元。
  "关键人物": [
    {
      "人物名称": "",
      // 一句话覆盖身份、核心欲望、关系变化与转变关键事件。
      "人物画像": ""
    }
  ],
  "剧情单元": [
    {
      "单元ID": "unit-001",
      "单元名称": "",
      "单元梗概": "",
      "主线推进": "",
      "关键人物": [
        {
          "人物名称": "",
          "单元作用与变化": ""
        }
      ],
      "关键信息": [],
      "高光时刻": [
        {
          "名称": "",
          "原文索引": "L1-L1"
        }
      ],
      // 取舍建议只有在确认后才会改变后续故事梗概。
      "改编建议": "保留",
      // 仅“合并”时填写目标“单元ID”；其余建议保持为空字符串。
      "合并目标单元ID": "",
      // 未确认时为 false；确认合并后本单元按目标单元融入后续故事梗概。
      "已确认合并": false,
      // 用一句话说明该单元为何保留、删除或并入目标单元。
      "建议原因": ""
    }
  ]
}
