{
  // 仅供内部计算使用；评分卡、报告和前端页面不得直接读取数值字段。
  "schema_version": "1.1.0",
  "满分": {
    "检查项": 100,
    "维度": 100,
    "总分": 100
  },
  // 检查项、维度和总分均使用同一阈值。
  "评级区间": [
    { "评级": "SS", "最低分": 98 },
    { "评级": "S", "最低分": 90 },
    { "评级": "A", "最低分": 80 },
    { "评级": "B", "最低分": 70 },
    { "评级": "C", "最低分": 60 },
    { "评级": "D", "最低分": 0 }
  ],
  "总体评级微调": {
    "规则": "所属评级区间上三分之一加号",
    "不使用加号的评级": ["SS"]
  },
  // 每个维度内的检查项暂按均分配置；调整权重只改本文件。
  "维度": [
    {
      "名称": "市场与选题",
      "权重": 10,
      "检查项": [
        { "名称": "核心卖点是否成立", "权重": 25 },
        { "名称": "标题与类型承诺是否一致", "权重": 25 },
        { "名称": "受众与市场是否匹配", "权重": 25 },
        { "名称": "卖点是否持续兑现", "权重": 25 }
      ]
    },
    {
      "名称": "故事结构与逻辑",
      "权重": 30,
      "检查项": [
        { "名称": "首集建局与戏剧张力", "权重": 25 },
        { "名称": "一卡是否完成入局", "权重": 25 },
        { "名称": "中段推进是否因果升级", "权重": 25 },
        { "名称": "终局是否完成主线", "权重": 25 }
      ]
    },
    {
      "名称": "人物与关系",
      "权重": 20,
      "检查项": [
        { "名称": "主角是否有主动目标", "权重": 25 },
        { "名称": "核心关系是否持续变化", "权重": 25 },
        { "名称": "对手是否形成有效反制", "权重": 25 },
        { "名称": "人物弧光与配角作用", "权重": 25 }
      ]
    },
    {
      "名称": "单集节奏与留存",
      "权重": 20,
      "检查项": [
        { "名称": "开场钩子与首次情绪释放", "权重": 25 },
        { "名称": "单集目标与结果反转", "权重": 25 },
        { "名称": "卡点与集尾悬念", "权重": 25 },
        { "名称": "重复控制与长线追看", "权重": 25 }
      ]
    },
    {
      "名称": "成片与制作",
      "权重": 15,
      "检查项": [
        { "名称": "内容量承载", "权重": 25 },
        { "名称": "旁白、对白与画面分工", "权重": 25 },
        { "名称": "画面可表达性与目标语台词", "权重": 25 },
        { "名称": "人物与资产一致性、镜头与场景连续性", "权重": 25 }
      ]
    },
    {
      "名称": "发行与风险",
      "权重": 5,
      "检查项": [
        { "名称": "用户粘性", "权重": 25 },
        { "名称": "传播潜力", "权重": 25 },
        { "名称": "内容合规性", "权重": 25 },
        { "名称": "价值观导向", "权重": 25 }
      ]
    }
  ]
}
